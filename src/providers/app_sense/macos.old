use objc2::{class, msg_send, sel, ClassType};
use objc2_foundation::{NSNotification, NSObject, NSString};
use std::cell::RefCell;
use std::sync::atomic::{AtomicBool, Ordering::Relaxed};
use std::sync::{Arc, Mutex};

use super::super::_base::Provider;

pub struct AppSenseProvider {
    is_started: Arc<AtomicBool>,
    current_app: Arc<Mutex<Option<String>>>,
}
impl AppSenseProvider {
    pub fn new() -> Box<dyn Provider> {
        let provider = AppSenseProvider {
            is_started: Arc::new(AtomicBool::new(false)),
            current_app: Arc::new(Mutex::new(None)),
        };
        return Box::new(provider);
    }
}
// Get the name of the currently active application
fn get_active_app_name() -> Option<String> {
    unsafe {
        let workspace: *const objc2::runtime::AnyObject = msg_send![class!(NSWorkspace), sharedWorkspace];
        let app: *const objc2::runtime::AnyObject = msg_send![workspace, frontmostApplication];

        if app.is_null() {
            return None;
        }

        let name: *const objc2::runtime::AnyObject = msg_send![app, localizedName];
        if name.is_null() {
            return None;
        }

        let ns_string: &NSString = &*(name as *const NSString);
        Some(ns_string.to_string())
    }
}

// Legacy function that now returns the current_app value from AppSenseProvider
pub fn get_frontmost_app() -> Option<String> {
    unsafe {
        let workspace: *const objc2::runtime::AnyObject = msg_send![class!(NSWorkspace), sharedWorkspace];
        let app: *const objc2::runtime::AnyObject = msg_send![workspace, frontmostApplication];

        if app.is_null() {
            return None;
        }

        let name: *const objc2::runtime::AnyObject = msg_send![app, localizedName];
        if name.is_null() {
            return None;
        }

        let ns_string: &NSString = &*(name as *const NSString);
        Some(ns_string.to_string())
    }
}
/*
Understanding the AppSenseProvider for macOS Application Focus Detection
Looking at your code, I can see you're building a system to track the currently active application on macOS using Objective-C bridging through Rust's objc2 crate. Let me explain what's happening and where the issue likely lies.

Current Implementation
Your code has two main components:

Helper functions (get_menubar_owning_app() and get_active_app_name()) that query the current frontmost application
AppSenseProvider that sets up a notification observer to detect application switching
The issue is that your current implementation isn't correctly processing the application change notifications. Here's why:

The Problem
When using NSWorkspaceDidActivateApplicationNotification, you should be extracting the application information from the notification object itself, rather than making a separate call to get_active_app_name().

The notification contains the application that was activated, but your code isn't extracting this information from the notification. Instead, it's calling get_active_app_name() which might not reflect the new state immediately.
*/

// Legacy function that now returns the current_app value from AppSenseProvider
pub fn get_menubar_owning_app() -> Option<String> {
    unsafe {
        let workspace: *const objc2::runtime::AnyObject = msg_send![class!(NSWorkspace), sharedWorkspace];
        let app: *const objc2::runtime::AnyObject = msg_send![workspace, frontmostApplication];

        if app.is_null() {
            return None;
        }

        let name: *const objc2::runtime::AnyObject = msg_send![app, localizedName];
        if name.is_null() {
            return None;
        }

        let ns_string: &NSString = &*(name as *const NSString);
        Some(ns_string.to_string())
    }

    impl Provider for AppSenseProvider {
        fn start(&self) {
            tracing::info!("AppSense Provider started");
            self.is_started.store(true, Relaxed);

            // Initialize with the current app
            if let Some(current_app) = get_active_app_name() {
                *self.current_app.lock().unwrap() = Some(current_app.clone());
                tracing::info!("Initial app: {:?}", current_app);
            }

            // Set up notification observers for app switching
            unsafe {
                let workspace: *const objc2::runtime::AnyObject = msg_send![class!(NSWorkspace), sharedWorkspace];
                let notification_center: *const objc2::runtime::AnyObject = msg_send![workspace, notificationCenter];

                // Clone Arc references for the callback
                let is_started = self.is_started.clone();
                let current_app = self.current_app.clone();

                // Create a thread to handle notifications
                std::thread::spawn(move || {
                    use objc2::rc::autoreleasepool;

                    autoreleasepool(|_| {
                        // Set up the observer
                        let notification_name = NSString::from_str("NSWorkspaceDidActivateApplicationNotification");
                        let _: () = msg_send![notification_center, addObserverForName:notification_name.as_ptr()
                                             object:std::ptr::null()
                                             queue:std::ptr::null()
                                             usingBlock:&mut |notification: *const objc2::runtime::AnyObject| {
                            if !is_started.load(Relaxed) {
                                return;
                            }

                            autoreleasepool(|_| {
                                // Get the new active application
                                if let Some(app_name) = get_active_app_name() {
                                    let mut app_guard = current_app.lock().unwrap();
                                    if app_guard.as_ref() != Some(&app_name) {
                                        *app_guard = Some(app_name.clone());
                                        tracing::info!("Application changed to: {:?}", app_name);
                                    }
                                }
                            });
                        }];

                        // Run loop to keep receiving notifications
                        let run_loop: *const objc2::runtime::AnyObject = msg_send![class!(NSRunLoop), currentRunLoop];

                        while is_started.load(Relaxed) {
                            autoreleasepool(|_| {
                                let _: () = msg_send![run_loop, runMode:NSString::from_str("kCFRunLoopDefaultMode").as_ptr() 
                                               beforeDate:msg_send![class!(NSDate), distantFuture]];
                            });
                        }

                        // Clean up when stopped
                        let _: () = msg_send![notification_center, removeObserver:notification_center];
                    });

                    tracing::info!("AppSense Provider notification observer stopped");
                });
            }
        }

        fn stop(&self) {
            self.is_started.store(false, Relaxed);
        }
    }

    fn stop(&self) {
        self.is_started.store(false, Relaxed);
    }
}
